d="p2" name="2. Static Blueprint (환경 1개)"><mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1700" pageHeight="1000" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2v1" value="Static Blueprint — 환경 하나의 구성" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1200" height="34" as="geometry"/></mxCell><mxCell id="p2v2" value="infra/blueprints/static/main.tf + infra/modules/{edge-cloudfront, s3-site-origin, observability-cloudfront} · 환경마다 별도 Terraform state" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1500" height="24" as="geometry"/></mxCell><mxCell id="p2v3" value="&lt;b&gt;범례&lt;/b&gt;&lt;br&gt;━ 실선: 구현됨 (Static)&lt;br&gt;┅ 회색 점선: 추천만 · 생성 미구현&lt;br&gt;&lt;font color='#DD344C'&gt;&lt;b&gt;빨간 테두리&lt;/b&gt;&lt;/font&gt;: 보안 경계 (비공개·인증·권한)&lt;br&gt;화살표: 호출·데이터 흐름" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=11;align=left;verticalAlign=top;spacing=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1360" y="10" width="300" height="128" as="geometry"/></mxCell><mxCell id="p2v4" value="&lt;b&gt;사이트 방문자&lt;/b&gt;&lt;br&gt;인터넷 사용자" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1;verticalAlign=bottom;spacingBottom=8;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="170" height="124" as="geometry"/></mxCell><mxCell id="p2v5" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#232F3E;fillColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="102" y="442" width="46" height="46" as="geometry"/></mxCell><mxCell id="p2v6" value="AWS Account (플랫폼 단