.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="p2v7"><mxGeometry x="117" y="52" width="46" height="46" as="geometry"/></mxCell><mxCell id="p2v11" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;HTTPS 리다이렉트 · OAC&lt;br&gt;보안 헤더 정책 · SPA 옵션" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;verticalAlign=bottom;spacingBottom=8;fontSize=11;fontColor=#232F3E;" vertex="1" parent="p2v7"><mxGeometry x="55" y="220" width="170" height="124" as="geometry"/></mxCell><mxCell id="p2v12" value="" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="p2v7"><mxGeometry x="117" y="232" width="46" height="46" as="geometry"/></mxCell><mxCell id="p2v13" value="&lt;b&gt;CloudWatch 알람·대시보드&lt;/b&gt;&lt;br&gt;PROD만 생성&lt;br&gt;5xx 등 오류 지표" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1;verticalAlign=bottom;spacingBottom=8;fontSize=11;fontColor=#232F3E;" vertex="1" parent="p2v7"><mxGeometry x="55" y="400" width="170" height="124" as="geometry"/></mxCell><mxCell id="p2v14" value="" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.alarm;" vertex="1" parent="p2v7"><mxGeometry x="117" y="412" width="46" height="46" as="geometry"/></mxCell><mxCell id="p2v15" value="&lt;b&gt;SNS 토픽&lt;/b&gt;&lt;br&gt;PROD만 · 소유자&lt;br&gt;이메일 구독" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1;verticalAlign=bottom;spacingBottom=8;fontSize=11;fontColor=#232F3E;" vertex="1" parent="p2v7"><mxGeometry x="55" y="580" width="170" height="124" as="geometry"/></mxCell><mxCell id="p2v16" value="" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="p2v7"><mxGeometry x="117" y="592" width="46" height="46" as="geometry"/></mxCell><mxCell id="p2v17" value="&lt;b&gt;S3 (사이트 원본)&lt;/b&gt;&lt;br&gt;비공개 · Public Access Block · SSE&lt;br&gt;버킷 정책: 이 배포의 OAC만&lt;br&gt;GetObject · TLS 강제" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;verticalAlign=bottom;spacingBottom=8;fontSize=11;fontColor=#232F3E;" vertex="1" parent="p2v8"><mxGeometry x="60" y="220" width="240" height="124" as="geometry"/></mxCell><mxCell id="p2v18" value="" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="p2v8"><mxGeometry x="157" y="232" width="46" height="46" as="geometry"/></mxCell><mxCell id="p2v19" value="&lt;b&gt;S3 (로그 · 플랫폼 공유)&lt;/b&gt;&lt;br&gt;envs/&amp;lt;env&amp;gt;/cloudfront/&lt;br&gt;접근 로그" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1;verticalAlign=bottom;spacingBottom=8;fontSize=11;fontColor=#232F3E;" vertex="1" parent="p2v8"><mxGeometry x="60" y="430" width="220" height="124" as="geometry"/></mxCell><mxCell id="p2v20" value="" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="p2v8"><mxGeometry x="147" y="442" width="46" height="46" as="geometry"/></mxCell><mxCell id="p2v21" value="&lt;b&gt;SSCP 플랫폼 (→ 1페이지)&lt;/b&gt;&lt;br&gt;runner: apply · 첫 배포&lt;br&gt;Publisher: 재배포 · 무효화&lt;br&gt;Worker: STATE · HTTP 검증" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1;verticalAlign=bottom;spacingBottom=8;fontSize=11;fontColor=#232F3E;" vertex="1" parent="p2v8"><mxGeometry x="440" y="220" width="260" height="124" as="geometry"/></mxCell><mxCell id="p2v22" value="&lt;b&gt;환경 하나에 붙는 규칙&lt;/b&gt;&lt;br&gt;• 이름: sscp-env-xxxxxxxx-&amp;lt;account&amp;gt;&lt;br&gt;• 태그: project · env-id · owner · tier · blueprint · expires-at(DEV)&lt;br&gt;• DEV: 7일 TTL 뒤 자동 삭제(연장 가능) · PROD: 관리자 승인, 자동 삭제 없음&lt;br&gt;• Terraform state: envs/&amp;lt;env&amp;gt;/terraform.tfstate (S3 native lockfile)&lt;br&gt;• 검증: PLAN(생성 전) → STATE(생성 후 설정) → HTTP(실제 주소 접속, S3 직접 접근 403 확인)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=11;align=left;verticalAlign=top;spacing=10;fontColor=#232F3E;" vertex="1" parent="p2v8"><mxGeometry x="440" y="430" width="520" height="190" as="geometry"/></mxCell><mxCell id="p2e23" value="HTTPS 요청" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2v4" target="p2v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e24" value="연결 (조건부)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="p2v7" source="p2v9" target="p2v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e25" value="OAC 서명 요청 (SigV4)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2v6" source="p2v11" target="p2v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e26" value="지표" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2v7" source="p2v11" target="p2v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e27" value="알림" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2v7" source="p2v13" target="p2v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e28" value="접근 로그" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="p2v6" source="p2v11" target="p2v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e29" value="사이트 파일 sync (rev-N)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#545B64;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2v8" source="p2v21" target="p2v17"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. 처리 흐름"><mxGraphModel dx="2140" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="2140" pageHeight="1000" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3v1" value="처리 흐름 — 요구사항에서 삭제까지" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="p3v2" value="두 입력 방식이 같은 Recommendation Engine을 거침(D-163) · 예산은 soft guard, 플랫폼 상한·quota·미구현은 hard guard(D-158)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1600" height="24" as="geometry"/></mxCell><mxCell id="p3v3" value="&lt;b&gt;범례&lt;/b&gt;&lt;br&gt;━ 실선: 구현됨 (Static)&lt;br&gt;┅ 회색 점선: 추천만 · 생성 미구현&lt;br&gt;&lt;font color='#DD344C'&gt;&lt;b&gt;빨간 테두리&lt;/b&gt;&lt;/font&gt;: 보안 경계 (비공개·인증·권한)&lt;br&gt;화살표: 호출·데이터 흐름" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontSize=11;align=left;verticalAlign=top;spacing=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1800" y="16" width="300" height="128" as="geometry"/></mxCell><mxCell id="p3v4" value="&lt;b&gt;맞춤형으로 만들기&lt;/b&gt;&lt;br&gt;프리셋 → 질문 8개" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="200" height="84" as="geometry"/></mxCell><mxCell id="p3v5" value="&lt;b&gt;빠르게 시작하기&lt;/b&gt;&lt;br&gt;Template STATIC_WEBSITE&lt;br&gt;(이름·용도·예산만)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="200" height="84" as="geometry"/></mxCell><mxCell id="p3v6" value="&lt;b&gt;Requirement Model&lt;/b&gt;&lt;br&gt;답변 또는 Template 기본값&lt;br&gt;→ 같은 Raw Input" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="290" y="200" width="200" height="84" as="geometry"/></mxCell><mxCell id="p3v7" value="&lt;b&gt;Recommendation Engine&lt;/b&gt;&lt;br&gt;Normalize → Gate → Filter&lt;br&gt;→ Rank → Budget → Policy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="540" y="190" width="200" height="104" as="geometry"/></mxCell><mxCell id="p3v8" value="결과 상태" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#B07D00;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="790" y="187" width="200" height="110" as="geometry"/></mxCell><mxCell id="p3v9" value="&lt;b&gt;OVER_BUDGET&lt;/b&gt; (soft)&lt;br&gt;완화안 적용 또는&lt;br&gt;초과 승인 budget_override" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#8A5300;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="40" width="200" height="84" as="geometry"/></mxCell><mxCell id="p3v10" value="&lt;b&gt;UNSUPPORTED / NEEDS_INPUT&lt;/b&gt;&lt;br&gt;원인 답변 + 대안 안내&lt;br&gt;→ ‘이 답변 바꾸기’" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C4262C;fontSize=11;fontColor=#8C1B20;" vertex="1" parent="1"><mxGeometry x="790" y="390" width="200" height="84" as="geometry"/></mxCell><mxCell id="p3v11" value="&lt;b&gt;zip 업로드&lt;/b&gt;&lt;br&gt;ARTIFACT 검사&lt;br&gt;(index.html · 크기 · 비밀값)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1060" y="200" width="200" height="84" as="geometry"/></mxCell><mxCell id="p3v12" value="&lt;b&gt;Admission (hard guard)&lt;/b&gt;&lt;br&gt;플랫폼 월 상한 · quota&lt;br&gt;· 생성 가능 Blueprint" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1310" y="200" width="200" height="84" as="geometry"/></mxCell><mxCell id="p3v13" value="&lt;b&gt;차단 (override 불가)&lt;/b&gt;&lt;br&gt;BUD_PLATFORM_CAP · quota" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C4262C;fontSize=11;fontColor=#8C1B20;" vertex="1" parent="1"><mxGeometry x="1310" y="40" width="200" height="84" as="geometry"/></mxCell><mxCell id="p3v14" value="&lt;b&gt;Serverless / Container&lt;/b&gt;&lt;br&gt;추천만 · 생성 미구현&lt;br&gt;UNSUP_BLUEPRINT_NOT_YET" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#AAB7B8;dashed=1;fontSize=11;fontColor=#7F8C8D;" vertex="1" parent="1"><mxGeometry x="1310" y="390" width="200" height="84" as="geometry"/></mxCell><mxCell id="p3v15" value="&lt;b&gt;PROD면 관리자 승인&lt;/b&gt;&lt;br&gt;DEV는 바로 진행&lt;br&gt;(7일 TTL 설정)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#B07D00;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1560" y="190" width="200" height="104" as="geometry"/></mxCell><mxCell id="p3v16" value="&lt;b&gt;PROVISIONING&lt;/b&gt;&lt;br&gt;CodeBuild: init → plan&lt;br&gt;→ PLAN 검증 → apply → 배포" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1560" y="600" width="200" height="104" as="geometry"/></mxCell><mxCell id="p3v17" value="&lt;b&gt;VALIDATING&lt;/b&gt;&lt;br&gt;Worker: STATE · HTTP 검증" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1310" y="610" width="200" height="84" as="geometry"/></mxCell><mxCell id="p3v18" value="판정" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#B07D00;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1060" y="597" width="200" height="110" as="geometry"/></mxCell><mxCell id="p3v19" value="&lt;b&gt;READY&lt;/b&gt;&lt;br&gt;사이트 주소 제공" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E7F7EE;strokeColor=#0B7A3B;fontSize=11;fontColor=#0B5A2C;" vertex="1" parent="1"><mxGeometry x="790" y="610" width